{
  "name": "enlighten",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design and test DALI lighting on a two-tape test bench.",
  "engines": {
    "node": "26.13.1",
    "pnpm": "12.18.0"
  },
  "packageManager": "pnpm@12.18.0",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.24.0",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "svelte-eslint-parser": "1.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "pnpm build && pnpm preview",
    "test": "vitest run --project unit",
    "test:prop": "vitest run --project prop",
    "e2e": "playwright test && playwright test -c playwright.server.config.ts",
    "e2e:server": "playwright test -c playwright.server.config.ts",
    "e2e:visual": "playwright test -c playwright.visual.config.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "verify": "pnpm lint && pnpm typecheck && pnpm coverage && pnpm build && pnpm e2e",
    "golden": "tools/golden/.venv/bin/python -I tools/golden/generate.py",
    "server": "server/.venv/bin/python -m server",
    "server:demo": "pnpm build && server/.venv/bin/python -m server --demo",
    "test:server": "server/.venv/bin/python -m pytest server -q",
    "coverage": "vitest run --coverage",
    "mutate": "PROP_RUNS=5 stryker run"
  },
  "dependencies": {
    "three": "0.187.0"
  }
}
